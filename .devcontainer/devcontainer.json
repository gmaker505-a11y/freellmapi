{
  "name": "FreeLLMAPI (browser setup)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup npm run dev > /tmp/freellmapi-dev.log 2>&1 &",
  "forwardPorts": [
    3001,
    5173
  ],
  "portsAttributes": {
    "3001": {
      "label": "FreeLLMAPI API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "FreeLLMAPI dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
